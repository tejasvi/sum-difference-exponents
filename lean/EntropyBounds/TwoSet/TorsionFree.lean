import Mathlib.LinearAlgebra.FreeModule.PID
import Mathlib.LinearAlgebra.FreeModule.Finite.Basic
import Mathlib.Algebra.Polynomial.Roots
import Mathlib.Algebra.Group.Pointwise.Finset.Basic
import Mathlib.Analysis.SpecialFunctions.Pow.Real

/-!
# From `ℤ` to torsion-free abelian groups

* `card_sub_le_of_int`: if `|X − Y| ≤ |X + Y|^λ` for all finite `X, Y ⊆ ℤ`, then the same holds for all finite
  subsets `X, Y` of any torsion-free abelian group.

The subgroup `M` generated by `X ∪ Y` is finitely generated and torsion-free, hence free of finite rank
(`Module.free_of_finite_type_torsion_free'`).  For a basis `b` (indices numbered by `e`), the linear form
`φₜ(v) = Σᵢ t^(e i) bᵢ*(v)` is the value at `t` of the polynomial `P_v = Σᵢ bᵢ*(v) X^(e i)`, which is nonzero for
`v ≠ 0` (`exists_linearForm_ne_zero`).  For `t ∈ ℤ` outside the roots of `∏_{v ∈ D} P_v`, with `D` the nonzero
differences of `(X + Y) ∪ (X − Y)`, the map `φₜ` is injective on `(X + Y) ∪ (X − Y)` (`exists_int_model`).  It maps
`X + Y` onto `φₜ(X) + φₜ(Y)` and `X − Y` onto `φₜ(X) − φₜ(Y)`, so both cardinalities are preserved.
-/

open Finset Pointwise

namespace EntropyBounds.TwoSet

/-- On a free `ℤ`-module of finite rank, a linear form that vanishes at no point of a finite set `D ∌ 0`. -/
lemma exists_linearForm_ne_zero {M : Type*} [AddCommGroup M] [Module.Free ℤ M] [Module.Finite ℤ M]
    (D : Finset M) (hD : (0 : M) ∉ D) : ∃ φ : M →ₗ[ℤ] ℤ, ∀ d ∈ D, φ d ≠ 0 := by
  classical
  set b := Module.Free.chooseBasis ℤ M
  set e := Fintype.equivFin (Module.Free.ChooseBasisIndex ℤ M)
  set P : M → Polynomial ℤ := fun d => ∑ i, Polynomial.monomial (e i : ℕ) (b.repr d i) with hPdef
  have hcoeff : ∀ d i, (P d).coeff (e i : ℕ) = b.repr d i := by
    intro d i
    simp only [hPdef, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
    rw [Finset.sum_eq_single i]
    · simp
    · intro j _ hji
      rw [ite_eq_right]
      intro h
      exact hji (e.injective (Fin.ext h))
    · intro h
      exact absurd (Finset.mem_univ i) h
  have hP : ∀ d ∈ D, P d ≠ 0 := by
    intro d hd h0
    apply hD
    have hrepr : b.repr d = 0 := by
      ext i
      rw [← hcoeff d i, h0, Polynomial.coeff_zero, Finsupp.coe_zero, Pi.zero_apply]
    rw [b.repr.map_eq_zero_iff] at hrepr
    rwa [hrepr] at hd
  have hQ : ∏ d ∈ D, P d ≠ 0 := Finset.prod_ne_zero_iff.2 hP
  obtain ⟨t, ht⟩ := Infinite.exists_notMem_finset (∏ d ∈ D, P d).roots.toFinset
  refine ⟨∑ i, (t ^ (e i : ℕ)) • b.coord i, fun d hd h0 => ht ?_⟩
  rw [Multiset.mem_toFinset, Polynomial.mem_roots hQ, Polynomial.IsRoot, Polynomial.eval_prod]
  refine Finset.prod_eq_zero hd ?_
  rw [← h0]
  simp only [hPdef, Polynomial.eval_finsetSum, Polynomial.eval_monomial, LinearMap.sum_apply,
    LinearMap.smul_apply, Module.Basis.coord_apply, smul_eq_mul]
  exact Finset.sum_congr rfl fun i _ => mul_comm _ _

variable {G : Type*} [AddCommGroup G] [IsAddTorsionFree G]

/-- **An integer model of `X` and `Y`**: a map `f : G → ℤ` with `f (x + y) = f x + f y` and `f (x − y) = f x − f y`
for `x ∈ X`, `y ∈ Y`, injective on `(X + Y) ∪ (X − Y)`. -/
lemma exists_int_model [DecidableEq G] (X Y : Finset G) :
    ∃ f : G → ℤ, (∀ x ∈ X, ∀ y ∈ Y, f (x + y) = f x + f y ∧ f (x - y) = f x - f y) ∧
      Set.InjOn f ↑((X + Y) ∪ (X - Y)) := by
  classical
  set M : Submodule ℤ G := Submodule.span ℤ ((X ∪ Y : Finset G) : Set G) with hM
  have : Module.IsTorsionFree ℤ M :=
    Function.Injective.moduleIsTorsionFree M.subtype Subtype.val_injective (fun _ _ => rfl)
  have : Module.Finite ℤ M := Module.Finite.span_finset ℤ (X ∪ Y)
  have : Module.Free ℤ M := Module.free_of_finite_type_torsion_free'
  have hXM : ∀ x ∈ X, x ∈ M := fun x hx => Submodule.subset_span (by simp [hx])
  have hYM : ∀ y ∈ Y, y ∈ M := fun y hy => Submodule.subset_span (by simp [hy])
  set T := (X + Y) ∪ (X - Y) with hTdef
  have hTM : ∀ t ∈ T, t ∈ M := by
    intro t ht
    rcases Finset.mem_union.1 ht with h | h
    · obtain ⟨x, hx, y, hy, rfl⟩ := Finset.mem_add.1 h
      exact M.add_mem (hXM x hx) (hYM y hy)
    · obtain ⟨x, hx, y, hy, rfl⟩ := Finset.mem_sub.1 h
      exact M.sub_mem (hXM x hx) (hYM y hy)
  let ι : T → M := fun t => ⟨t.1, hTM t.1 t.2⟩
  let D : Finset M :=
    ((T.attach ×ˢ T.attach).filter (fun p => p.1 ≠ p.2)).image (fun p => ι p.1 - ι p.2)
  have hD : (0 : M) ∉ D := by
    intro h0
    obtain ⟨p, hp, hp0⟩ := Finset.mem_image.1 h0
    apply (Finset.mem_filter.1 hp).2
    apply Subtype.ext
    have h1 := congrArg Subtype.val hp0
    simp only [Submodule.coe_sub, ZeroMemClass.coe_zero, sub_eq_zero, ι] at h1
    exact h1
  obtain ⟨φ, hφ⟩ := exists_linearForm_ne_zero D hD
  refine ⟨fun g => if h : g ∈ M then φ ⟨g, h⟩ else 0, ?_, ?_⟩
  · intro x hx y hy
    have hx' := hXM x hx
    have hy' := hYM y hy
    simp only [dite_eq_left hx', dite_eq_left hy', dite_eq_left (M.add_mem hx' hy'), dite_eq_left (M.sub_mem hx' hy')]
    constructor
    · rw [← map_add]
      rfl
    · rw [← map_sub]
      rfl
  · intro s hs s' hs' hss'
    simp only [dite_eq_left (hTM s hs), dite_eq_left (hTM s' hs')] at hss'
    by_contra hne
    have hmem : (⟨s, hTM s hs⟩ : M) - ⟨s', hTM s' hs'⟩ ∈ D := by
      simp only [D, Finset.mem_image, Finset.mem_filter, Finset.mem_product, Finset.mem_attach, true_and]
      refine ⟨(⟨s, hs⟩, ⟨s', hs'⟩), ?_, rfl⟩
      intro h
      exact hne (congrArg Subtype.val h)
    exact hφ _ hmem (by rw [map_sub, hss', sub_self])

/-- **Transfer from `ℤ`.**  A pair ceiling `|X − Y| ≤ |X + Y|^λ` for all finite subsets of `ℤ` holds for all finite
subsets of every torsion-free abelian group. -/
theorem card_sub_le_of_int {lam : ℝ}
    (hZ : ∀ X Y : Finset ℤ, ((X - Y).card : ℝ) ≤ ((X + Y).card : ℝ) ^ lam)
    [DecidableEq G] (X Y : Finset G) : ((X - Y).card : ℝ) ≤ ((X + Y).card : ℝ) ^ lam := by
  classical
  obtain ⟨f, hadd, hinj⟩ := exists_int_model X Y
  have himg_add : (X + Y).image f = X.image f + Y.image f := by
    ext z
    simp only [Finset.mem_image, Finset.mem_add]
    constructor
    · rintro ⟨s, ⟨x, hx, y, hy, rfl⟩, rfl⟩
      exact ⟨f x, ⟨x, hx, rfl⟩, f y, ⟨y, hy, rfl⟩, (hadd x hx y hy).1.symm⟩
    · rintro ⟨_, ⟨x, hx, rfl⟩, _, ⟨y, hy, rfl⟩, rfl⟩
      exact ⟨x + y, ⟨x, hx, y, hy, rfl⟩, (hadd x hx y hy).1⟩
  have himg_sub : (X - Y).image f = X.image f - Y.image f := by
    ext z
    simp only [Finset.mem_image, Finset.mem_sub]
    constructor
    · rintro ⟨s, ⟨x, hx, y, hy, rfl⟩, rfl⟩
      exact ⟨f x, ⟨x, hx, rfl⟩, f y, ⟨y, hy, rfl⟩, (hadd x hx y hy).2.symm⟩
    · rintro ⟨_, ⟨x, hx, rfl⟩, _, ⟨y, hy, rfl⟩, rfl⟩
      exact ⟨x - y, ⟨x, hx, y, hy, rfl⟩, (hadd x hx y hy).2⟩
  have hc_add : ((X + Y).image f).card = (X + Y).card :=
    Finset.card_image_of_injOn (hinj.mono (by simp))
  have hc_sub : ((X - Y).image f).card = (X - Y).card :=
    Finset.card_image_of_injOn (hinj.mono (by simp))
  have h := hZ (X.image f) (Y.image f)
  rwa [← himg_add, ← himg_sub, hc_add, hc_sub] at h

end EntropyBounds.TwoSet
