import EntropyBounds.GlueZ.Certs.C3BALL.General
import EntropyBounds.GlueG.SetFormProd

/-!
# Theorem 1.2 of the paper: every abelian group

`(λ_X, λ_Y, λ_S) = (882/1259, 1609/2518, 2467/5036)`, whose sum is `9213/5036 < 1.8294282` (`lambda_sum`).  For every
abelian group `G` (with decidable equality, which is no restriction classically):

* `thm12_entropy`: `H(X − Y) ≤ λ_X H(X) + λ_Y H(Y) + λ_S H(X + Y)` for every pair `(X, Y)` of `G`-valued random
  variables with finitely many values, given by its law `p` on a finite set `Γ ⊆ G × G` (statement (a));
* `thm12_set`: `|A −_P B| ≤ |A|^λ_X |B|^λ_Y |A +_P B|^λ_S` for finite `A, B ⊆ G` and `P ⊆ A × B`, where
  `A ±_P B = {a ± b : (a, b) ∈ P}` (statement (b)).

Both are proved from the certificate `c3b_allgroups.json` (`EntropyBounds.GlueZ.Certs.C3BALL`, generated by
tools/export_glue_z.py).  All its multipliers are `1`, so no hypothesis on 2-torsion appears.
-/

open Finset

namespace EntropyBounds.GlueZ.Certs.C3BALL

open EntropyBounds.Iid EntropyBounds.GlueG SumsDifferences SumsDifferences.NonShannon

/-- `λ_X + λ_Y + λ_S = 9213/5036 < 1.8294282`. -/
theorem lambda_sum :
    (882 / 1259 : ℝ) + 1609 / 2518 + 2467 / 5036 = 9213 / 5036 ∧ (9213 / 5036 : ℝ) < 1.8294282 := by
  norm_num

/-- **Theorem 1.2, statement (a)**: the entropy form in every abelian group. -/
theorem thm12_entropy {G : Type} [AddCommGroup G] [DecidableEq G] (Γ : Finset (G × G)) (p : G × G → ℝ)
    (hp : ∀ q ∈ Γ, 0 ≤ p q) (hs : ∑ q ∈ Γ, p q = 1) :
    pushEntropy Γ p (fun q => q.1 - q.2) ≤ (882 / 1259 : ℝ) * pushEntropy Γ p (fun q => q.1)
      + (1609 / 2518 : ℝ) * pushEntropy Γ p (fun q => q.2)
      + (2467 / 5036 : ℝ) * pushEntropy Γ p (fun q => q.1 + q.2) :=
  entropy_ineq_general Γ p hp hs

/-- **Theorem 1.2, statement (b)**: the set form in every abelian group. -/
theorem thm12_set {G : Type} [AddCommGroup G] [DecidableEq G] (A B : Finset G) (P : Finset (G × G))
    (hP : P ⊆ A ×ˢ B) :
    (#(P.image fun q => q.1 - q.2) : ℝ)
      ≤ (#A : ℝ) ^ (882 / 1259 : ℝ) * (#B : ℝ) ^ (1609 / 2518 : ℝ)
        * (#(P.image fun q => q.1 + q.2) : ℝ) ^ (2467 / 5036 : ℝ) :=
  set_form_prod (by norm_num) (by norm_num) (by norm_num) (fun Γ p hinj hp hs => entropy_ineq Γ p hinj hp hs)
    A B P hP

end EntropyBounds.GlueZ.Certs.C3BALL
